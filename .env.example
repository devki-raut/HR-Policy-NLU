# EmployeeAssist example configuration
JUPYTER_TOKEN=change-me

# Darwinbox tenant and shared SHA-512 authentication.
DARWINBOX_BASE_URL=https://YOUR-TENANT.darwinbox.in
DARWINBOX_UID=
DARWINBOX_ADMIN_EMAIL=
DARWINBOX_SECRET_KEY=
DARWINBOX_TIMEOUT_SECONDS=15

# Employee directory adapter. A full sync runs at startup; changes refresh hourly.
DARWINBOX_EMPLOYEE_PATH=/masterapi/employee
DARWINBOX_EMPLOYEE_URL=
DARWINBOX_EMPLOYEE_DATASET_KEY=
# Backward-compatible dataset key fallback.
DARWINBOX_DATASET_KEY=
DARWINBOX_EMPLOYEE_SYNC_INTERVAL_SECONDS=3600
DARWINBOX_EMPLOYEE_SYNC_REQUIRED=false
DARWINBOX_FULL_REFRESH_ON_MISS=true
DARWINBOX_EMPLOYEE_STORE_PATH=
DARWINBOX_EMPLOYEE_NUMBER_FIELDS=employee_no,employee_number,employee_code,employee_id,user_id
DARWINBOX_EMPLOYEE_EMAIL_FIELDS=official_email,official_email_id,office_email,email_id,email,work_email
DARWINBOX_EMPLOYEE_NAME_FIELDS=employee_name,full_name,name
DARWINBOX_EMPLOYEE_STATUS_FIELDS=employee_status,status,employment_status

# Leave adapter. Darwinbox must provide the tenant-specific balance path.
DARWINBOX_LEAVE_BALANCE_PATH=/YOUR-PROVISIONED-LEAVE-BALANCE-ENDPOINT
# Optional absolute URL retained for tenant-specific/legacy endpoints.
DARWINBOX_LEAVE_BALANCE_URL=
DARWINBOX_LEAVE_BALANCE_METHOD=POST
DARWINBOX_LEAVE_DATASET_KEY=
DARWINBOX_LEAVE_EMPLOYEE_FIELD=employee_no
DARWINBOX_EMPLOYEE_FIELD=employee_no

# Optional administrator-provided bootstrap mappings.
DARWINBOX_EMPLOYEE_MAP_JSON={}
DARWINBOX_EMPLOYEE_MAP_FILE=
