# EmployeeAssist example configuration
JUPYTER_TOKEN=change-me

# Microsoft Entra / Teams tab SSO. Set required=true after the Entra app exposes
# api://dockerpoc-webapp01.azurewebsites.net/<client-id>/access_as_user and its
# web redirect URI is registered.
ENTRA_CLIENT_ID=
ENTRA_TENANT_ID=organizations
ENTRA_AUTH_REQUIRED=false
IDENTITY_STORE_PATH=
GUEST_EMPLOYEE_EMAIL=guest
DEFAULT_EMPLOYEE_EMAIL=guest
DEFAULT_EMPLOYEE_CODE=Ell0769
DARWINBOX_EMPLOYEE_MAP_FILE=data/employee_directory.json

# Darwinbox tenant and shared SHA-512 authentication.
DARWINBOX_BASE_URL=https://YOUR-TENANT.darwinbox.in
DARWINBOX_UID=
DARWINBOX_ADMIN_EMAIL=
DARWINBOX_SECRET_KEY=
DARWINBOX_TIMEOUT_SECONDS=15

# Employee directory adapter. A full sync runs at startup; changes refresh hourly.
DARWINBOX_EMPLOYEE_PATH=/masterapi/employee
DARWINBOX_EMPLOYEE_URL=
DARWINBOX_EMPLOYEE_DATASET_KEY=
# Backward-compatible dataset key fallback.
DARWINBOX_DATASET_KEY=
DARWINBOX_EMPLOYEE_SYNC_INTERVAL_SECONDS=3600
DARWINBOX_EMPLOYEE_SYNC_REQUIRED=false
DARWINBOX_FULL_REFRESH_ON_MISS=true
DARWINBOX_EMPLOYEE_STORE_PATH=
DARWINBOX_EMPLOYEE_NUMBER_FIELDS=employee_no,employee_number,employee_code,employee_id,user_id
DARWINBOX_EMPLOYEE_EMAIL_FIELDS=official_email,official_email_id,office_email,email_id,email,work_email
DARWINBOX_EMPLOYEE_NAME_FIELDS=employee_name,full_name,name
DARWINBOX_EMPLOYEE_STATUS_FIELDS=employee_status,status,employment_status

# Report Builder employee snapshot. This has a separate API key/report ID and
# replaces the active email mapping daily at 16:30 Asia/Kolkata. Report Basic
# Auth falls back to the leave username/password when the overrides are empty.
DARWINBOX_REPORT_URL=https://emergys.darwinbox.in/reportsbuilderapi/reportdata
DARWINBOX_REPORT_PATH=/reportsbuilderapi/reportdata
DARWINBOX_REPORT_API_KEY=
DARWINBOX_REPORT_ID=
DARWINBOX_REPORT_SYNC_HOUR=16
DARWINBOX_REPORT_SYNC_MINUTE=30

# Leave adapter. Darwinbox must provide the tenant-specific balance path.
DARWINBOX_LEAVE_BALANCE_PATH=/leavesactionapi/leavebalance
# Optional absolute URL retained for tenant-specific/legacy endpoints.
DARWINBOX_LEAVE_BALANCE_URL=
DARWINBOX_LEAVE_BALANCE_METHOD=POST
# API-key leave endpoint contract.
DARWINBOX_LEAVE_API_KEY=
# HTTP Basic Auth credentials provisioned for the leave endpoint.
DARWINBOX_LEAVE_USERNAME=
DARWINBOX_LEAVE_PASSWORD=
DARWINBOX_LEAVE_IGNORE_ROUNDING=1
DARWINBOX_LEAVE_NAMES=Comp off,ESOL_ Privilege Leave,ESOL_ Casual Leave,Emergys_Bereavement Leave,Leave Without Pay

# Holiday adapter. Darwinbox must authorize this endpoint for the API key.
DARWINBOX_HOLIDAY_PATH=/leavesactionapi/holidaylist
DARWINBOX_HOLIDAY_URL=https://emergys.darwinbox.in/leavesactionapi/holidaylist
# Holiday API key is provisioned separately. Basic Auth defaults to the
# leave-balance username/password unless these optional overrides are set.
DARWINBOX_HOLIDAY_API_KEY=
DARWINBOX_HOLIDAY_USERNAME=
DARWINBOX_HOLIDAY_PASSWORD=
# SHA-512 leave endpoint fallback, when provisioned instead of an API key.
DARWINBOX_LEAVE_DATASET_KEY=
DARWINBOX_LEAVE_EMPLOYEE_FIELD=employee_no
DARWINBOX_EMPLOYEE_FIELD=employee_no

# Optional administrator-provided bootstrap mappings.
DARWINBOX_EMPLOYEE_MAP_JSON={}
DARWINBOX_EMPLOYEE_MAP_FILE=

# Azure Bot OAuth connection name (Microsoft Entra v2, delegated Graph
# User.Read Mail.Send offline_access). Uses the signed-in Teams user's mailbox.
# Register the Bot Framework OAuth redirect URI shown by Azure Bot Service.
TEAMS_MAIL_OAUTH_CONNECTION=
