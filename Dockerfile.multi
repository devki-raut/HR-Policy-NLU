# ==========================================
# Stage 1: Build & Install Dependencies
# ==========================================
FROM python:3.10-slim AS builder

WORKDIR /app

# Install system build essentials if any packages require compilation
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Create a virtual environment to cleanly isolate site-packages
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Copy and install Python dependencies
COPY requirements.txt /app/requirements.txt
ARG TORCH_VERSION=2.12.1+cpu
RUN python -m pip install --no-cache-dir --upgrade pip && \
    python -m pip install --no-cache-dir \
      --index-url https://download.pytorch.org/whl/cpu \
      "torch==${TORCH_VERSION}" && \
    python -m pip install --no-cache-dir -r /app/requirements.txt


# ==========================================
# Stage 2: Final Production Deployment
# ==========================================
FROM python:3.10-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    RASA_TELEMETRY_ENABLED=false \
    HOME=/app \
    HF_HOME=/app/.cache \
    PYTHONPATH=/app \
    PATH="/opt/venv/bin:$PATH"

WORKDIR /app

# Copy the pre-built virtual environment from the 'builder' stage
COPY --from=builder /opt/venv /opt/venv

# Copy application source code and assets
COPY actions /app/actions
COPY data /app/data
COPY teams_app /app/teams_app
COPY scripts /app/scripts
COPY config.yml domain.yml endpoints.yml /app/
COPY models /app/models

# Setup a secure non-root user
RUN useradd --create-home --uid 10001 appuser && \
    mkdir -p /app/.cache /app/data/policies && \
    chown -R appuser:appuser /app
USER appuser

EXPOSE 8610

FROM base AS deployment
# The supervisor starts private Rasa + actions and the public FastAPI server.
CMD ["python", "scripts/run_deployment.py", "web"]